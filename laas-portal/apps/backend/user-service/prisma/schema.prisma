// This is your Prisma schema file for User Service
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum SystemRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

enum OrganizationType {
  UNIVERSITY
  COMPANY
  DEPARTMENT
  OTHER
}

// ============================================
// USER ENTITY
// ============================================

model User {
  id              String      @id @default(uuid()) @db.Uuid
  keycloakUserId  String?     @unique @map("keycloak_user_id")
  
  // Basic Info (synced from Keycloak)
  email           String      @unique
  username        String      @unique
  
  // Profile Info (managed by User Service)
  fullName        String?     @map("full_name")
  avatar          String?
  phone           String?
  language        String      @default("en")
  timezone        String      @default("UTC")
  
  // Extended Profile Info
  dateOfBirth     DateTime?   @map("date_of_birth")
  gender          String?
  address         String?
  bio             String?
  studentCode     String?     @unique @map("student_code")
  
  // Organization Info
  organization    String?
  department      String?
  
  // System Info
  systemRole      SystemRole  @default(STUDENT) @map("system_role")
  status          UserStatus  @default(ACTIVE)
  passwordHash    String?     @map("password_hash")
  
  // Preferences
  emailNotifications   Boolean @default(true) @map("email_notifications")
  courseUpdates        Boolean @default(true) @map("course_updates")
  labReminders         Boolean @default(true) @map("lab_reminders")
  achievementsNotifications Boolean @default(true) @map("achievements_notifications")
  theme                String  @default("light")
  
  // Admin & Instructor Notes
  adminNotes      String?     @map("admin_notes")
  instructorNotes String?     @map("instructor_notes")
  
  // Metadata
  lastLoginAt     DateTime?   @map("last_login_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  // Relations
  userGroups      UserGroup[]
  userOrganizations UserOrganization[]
  editHistory     UserEditHistory[]
  
  @@index([email])
  @@index([keycloakUserId])
  @@index([systemRole])
  @@index([status])
  @@index([studentCode])
  @@map("users")
}

// ============================================
// ORGANIZATION ENTITY
// ============================================

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  code        String             @unique
  type        OrganizationType   @default(UNIVERSITY)
  description String?
  logoUrl     String?            @map("logo_url")
  
  // Metadata
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  
  // Relations
  groups      Group[]
  userOrganizations UserOrganization[]
  
  @@index([code])
  @@index([isActive])
  @@map("organizations")
}

// ============================================
// GROUP ENTITY (Class / Team / Department)
// ============================================

model Group {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  
  name           String
  code           String      @unique
  description    String?
  
  // Group Type: CLASS | TEAM | DEPARTMENT
  type           String      @default("CLASS")
  
  // Class-specific fields
  semester       String?
  schedule       String?
  location       String?
  coverImage     String?     @map("cover_image")
  maxStudents    Int?        @map("max_students")
  startDate      DateTime?   @map("start_date")
  endDate        DateTime?   @map("end_date")
  
  // Metadata
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  
  // Relations
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userGroups     UserGroup[]
  
  @@index([organizationId])
  @@index([code])
  @@index([isActive])
  @@map("groups")
}

// ============================================
// MANY-TO-MANY: USER ↔ GROUP
// ============================================

model UserGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  
  // Role in this group (e.g., STUDENT, INSTRUCTOR, TA)
  roleInGroup String @default("STUDENT") @map("role_in_group")
  
  // Metadata
  joinedAt  DateTime @default(now()) @map("joined_at")
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_groups")
}

// ============================================
// MANY-TO-MANY: USER ↔ ORGANIZATION
// ============================================

model UserOrganization {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  
  // Role in organization (e.g., ADMIN, MEMBER)
  roleInOrganization String   @default("MEMBER") @map("role_in_organization")
  
  // Metadata
  joinedAt       DateTime     @default(now()) @map("joined_at")
  
  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_organizations")
}

// ============================================
// REFRESH TOKENS (managed by auth-service)
// ============================================

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================
// OAUTH PROVIDERS (managed by auth-service)
// ============================================

model OAuthProvider {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   // "google" | "facebook"
  providerId  String   @map("provider_id")
  email       String?
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_providers")
}

// ============================================
// PASSWORD RESET TOKENS (managed by auth-service)
// ============================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// USER EDIT HISTORY
// ============================================

model UserEditHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  editorId    String   @map("editor_id")
  editorName  String   @map("editor_name")
  
  // What changed
  fieldName   String   @map("field_name")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  description String?
  
  // Metadata
  editedAt    DateTime @default(now()) @map("edited_at")
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([editedAt])
  @@map("user_edit_history")
}
